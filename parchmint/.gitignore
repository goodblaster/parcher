# Build artifacts
/bin/
/dist/

# Archive outputs
*.html.bak
*.mht
*.mhtml

# …but test fixtures are source, not output.
!**/testdata/*.mht

# Environment
.env
.env.local

# Go workspace
go.work
go.work.sum

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Capture outputs
*.html
*.pdf
*.png
*.jpg
*.jpeg
# …except test fixtures, which are pages on purpose. Without this the probe
# suite's page is silently left out of a commit and `make probe` fails in CI.
!**/testdata/*.html
!**/testdata/*.png

# Stray binary from `go build ./cmd/parch` without -o bin/
/parch
